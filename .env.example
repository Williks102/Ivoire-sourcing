# --- Frontend (VITE_ variables are bundled in the browser) ---
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_BUCKET_CV_ID=
# Affichage uniquement : gardez la même valeur que COMMISSION_RATE
VITE_COMMISSION_RATE=0.12

# --- Vercel serverless API (never expose with VITE_) ---
# Clé Gemini (facultative) : modération, analyse des missions, brouillon des messages WhatsApp
GEMINI_API_KEY=
# Modèle utilisé (défaut : gemini-2.5-flash)
GEMINI_MODEL=
PAIEMENTPRO_MERCHANT_ID=
# Taux réellement appliqué par le serveur (0.12 = 12 %)
COMMISSION_RATE=0.12
PAYMENT_WEBHOOK_SECRET=
APP_URL=
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_API_KEY=
